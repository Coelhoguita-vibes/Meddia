{
  "name": "meddia-app",
  "version": "1.1.0",
  "description": "Aplicativo MedDia para controle diário e estoque de medicamentos",
  "private": true,
  "scripts": {
    "build": "esbuild www/app.js --bundle --format=iife --target=es2017 --outfile=www/app.bundle.js",
    "cap:init": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "esbuild": "^0.24.0"
  }
}
